# ============================================================
#  .gitattributes — Atributos de archivos en el repositorio
# ============================================================

# Normaliza saltos de línea (LF) y evita que Git "arregle" los binarios
* text=auto

# --- Archivos de texto de la tesis: normalizar LF ---
*.tex      text
*.bib      text
*.md       text
*.txt      text
*.sh       text
*.owl      text
Makefile   text
*.mk       text

# --- Iconos de línea final para algunos tipos ---
*.pdf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary

