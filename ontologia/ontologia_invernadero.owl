<?xml version="1.0"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
]>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xml:base="http://www.tesis.uni.edu.co/ontologias/invernadero">

  <!-- ========================================================
       ONTOLOGIA DEL INVERNADERO INTELIGENTE (ESQUELETO INICIAL)
       Proyecto de tesis. Edita este archivo en Protege.
       Reemplaza la IRI base por la que uses en tu proyecto.
       ======================================================== -->

  <owl:Ontology rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero">
    <rdfs:comment xml:lang="es">Ontologia del dominio del invernadero inteligente. Esqueleto inicial para el proyecto de tesis.</rdfs:comment>
    <rdfs:label xml:lang="es">Ontologia del invernadero</rdfs:label>
  </owl:Ontology>


  <!-- ============= Clases principales ============= -->

  <owl:Class rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#Invernadero">
    <rdfs:label xml:lang="es">Invernadero</rdfs:label>
    <rdfs:comment xml:lang="es">Estructura fisica donde se cultiva y se controla el clima.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#Sensor">
    <rdfs:label xml:lang="es">Sensor</rdfs:label>
    <rdfs:comment xml:lang="es">Dispositivo que mide una variable ambiental (temperatura, humedad, luz, CO2, etc.).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#Actuador">
    <rdfs:label xml:lang="es">Actuador</rdfs:label>
    <rdfs:comment xml:lang="es">Dispositivo que ejecuta una accion (ventilador, bomba de riego, persiana, calefactor, etc.).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#Cultivo">
    <rdfs:label xml:lang="es">Cultivo</rdfs:label>
    <rdfs:comment xml:lang="es">Planta o especie que se cultiva dentro del invernadero.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#Medicion">
    <rdfs:label xml:lang="es">Medicion</rdfs:label>
    <rdfs:comment xml:lang="es">Lectura de un sensor en un instante de tiempo.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#VariableAmbiental">
    <rdfs:label xml:lang="es">Variable ambiental</rdfs:label>
    <rdfs:comment xml:lang="es">Magnitud que se mide o controla (temperatura, humedad relativa, CO2, luminosidad, etc.).</rdfs:comment>
  </owl:Class>


  <!-- ============= Propiedades de objeto (relaciones) ============= -->

  <owl:ObjectProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#mide">
    <rdfs:label xml:lang="es">mide</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Sensor"/>
    <rdfs:range  rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#VariableAmbiental"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#controla">
    <rdfs:label xml:lang="es">controla</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Actuador"/>
    <rdfs:range  rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#VariableAmbiental"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#ubicadoEn">
    <rdfs:label xml:lang="es">ubicado en</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Invernadero"/>
    <rdfs:range  rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Sensor"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#seCultiva">
    <rdfs:label xml:lang="es">se cultiva</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Invernadero"/>
    <rdfs:range  rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Cultivo"/>
  </owl:ObjectProperty>


  <!-- ============= Propiedades de datos ============= -->

  <owl:DatatypeProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#valor">
    <rdfs:label xml:lang="es">valor</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Medicion"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#unidad">
    <rdfs:label xml:lang="es">unidad</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Medicion"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.tesis.uni.edu.co/ontologias/invernadero#fechaHora">
    <rdfs:label xml:lang="es">fecha y hora</rdfs:label>
    <rdfs:domain rdf:resource="http://www.tesis.uni.edu.co/ontologias/invernadero#Medicion"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

</rdf:RDF>
