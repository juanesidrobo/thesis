# ============================================================
#  latexmkrc — Configuración de latexmk para XeLaTeX + biber
#
#  Permite compilar directamente con:
#      latexmk main.tex
#  (sin necesidad de pasar argumentos).
# ============================================================

# Motor de compilación
#   1 = pdflatex
#   5 = xelatex
#   6 = lualatex
$pdf_mode = 5;                 # XeLaTeX

# Procesar la bibliografía cuando sea necesario. El backend biber se detecta
# mediante el archivo .bcf generado por biblatex; este valor no elige el motor.
$bibtex_use = 2;

# Directorios de salida (temporales y PDF)
$out_dir = 'build';
$aux_dir = 'build';

# Archivo principal por defecto
@default_files = ('main');

# Limpieza: extensión de los temporales que se borran con "latexmk -C"
$clean_ext = "%R.aux %R.bbl %R.bcf %R.blg %R.fls %R.idx %R.ilg %R.ind \
              %R.lof %R.log %R.lot %R.out %R.run.xml %R.toc %R.xdv \
              %R.synctex.gz %R.vrb %R.nav %R.snm";
